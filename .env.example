# Meta webhook verification token (set same value in Meta App Dashboard)
META_VERIFY_TOKEN=your_verify_token_here

# Page access token for the Facebook Page linked to your Instagram account
META_PAGE_ACCESS_TOKEN=your_page_access_token_here

# App secret from Meta App Dashboard > Settings > Basic
META_APP_SECRET=your_app_secret_here

# Instagram Business Account ID (from webhook entry.id)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Optional: override public URL for image attachments (defaults to RENDER_EXTERNAL_URL on Render)
# PUBLIC_BASE_URL=https://your-app.onrender.com

# Optional: Graph API version (default: v22.0)
# GRAPH_API_VERSION=v22.0
